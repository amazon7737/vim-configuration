#!/usr/bin/env bash
# claude-snapshot 이 기록해둔 목록으로 Claude Code 세션들을 tmux 안에 되살린다.
# 재부팅 후 한 번 실행하면 창 배치와 각 창의 대화가 복구된다.
#
#   claude-restore --dry-run   무엇이 뜰지 미리보기 (아무것도 실행 안 함)
#   claude-restore             실제 복원
#   claude-restore -s 이름     대상 tmux 세션 지정 (기본: agents)
#   claude-restore -f 파일     다른 스냅샷 파일 사용
#                              (예: ~/.claude/session-snapshot.tsv.prev)
#
# 이미 같은 (디렉터리, 세션 ID)로 돌고 있는 건 건너뛴다 — 중복 실행 방지.
# 출처가 guess 인 항목은 * 로 표시된다 (추정이라 어긋날 수 있음).
set -euo pipefail

SNAP="$HOME/.claude/session-snapshot.tsv"
SESSION="agents"
DRY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|-n) DRY=1 ;;
    --session|-s) SESSION="${2:?세션 이름이 필요해}"; shift ;;
    --file|-f)    SNAP="${2:?스냅샷 파일 경로가 필요해}"; shift ;;
    -h|--help)
      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "알 수 없는 옵션: $1" >&2; exit 1 ;;
  esac
  shift
done

[ -f "$SNAP" ] || { echo "스냅샷이 없어: $SNAP" >&2; exit 1; }
command -v tmux >/dev/null || { echo "tmux 가 없어" >&2; exit 1; }

# 지금 이미 돌고 있는 것들 (claude-snapshot 과 동일한 수집 로직 재사용)
running="$(claude-snapshot --print 2>/dev/null | cut -f1,2 || true)"

planned=0
skipped=0
target=""
reuse_win=""

# tmux 세션 확보 — dry-run 이면 호출되지 않으므로 아무것도 만들지 않는다.
# 세션을 새로 만드는 경우(재부팅 직후가 이 경우다) 기본으로 딸려오는 창을
# 첫 항목에 그대로 쓴다. 안 그러면 빈 zsh 창이 하나 남는다.
#   $1 = 첫 항목의 작업 디렉터리, $2 = 창 이름
ensure_session() {
  [ -n "$target" ] && return 0
  if [ -n "${TMUX:-}" ]; then
    target="$(tmux display-message -p '#S')"
  elif tmux has-session -t "$SESSION" 2>/dev/null; then
    target="$SESSION"
  else
    tmux new-session -d -s "$SESSION" -c "$1" -n "$2"
    target="$SESSION"
    reuse_win="$(tmux list-windows -t "$SESSION:" -F '#{window_id}' | head -1)"
  fi
}

echo "스냅샷: $SNAP"
echo

while IFS=$'\t' read -r cwd sid origin; do
  [ -n "${cwd:-}" ] || continue

  # "-" 는 세션 ID 없음. 그리고 옛 형식(빈 칸)으로 저장된 파일은 탭이
  # 합쳐지면서 출처 값이 sid 자리로 밀려 들어오므로 되돌려준다.
  case "${sid:-}" in
    -|"")        sid=""; origin="${origin:-cmd}" ;;
    cmd|guess)   origin="$sid"; sid="" ;;
  esac

  if [ ! -d "$cwd" ]; then
    echo "  건너뜀 (디렉터리 없음): $cwd"
    skipped=$((skipped + 1))
    continue
  fi

  if printf '%s\n' "$running" | grep -qxF "$cwd	$sid"; then
    echo "  건너뜀 (이미 실행 중): $cwd${sid:+  ${sid%%-*}}"
    skipped=$((skipped + 1))
    continue
  fi

  if [ -n "$sid" ]; then
    cmd="claude --resume $sid"
  else
    # 세션 ID를 끝내 못 구했으면 그 디렉터리의 가장 최근 대화를 이어받는다
    cmd="claude -c"
  fi

  mark=" "
  [ "${origin:-}" = "guess" ] && mark="*"

  name="${cwd##*/}"
  planned=$((planned + 1))

  if [ "$DRY" -eq 0 ]; then
    ensure_session "$cwd" "$name"
    if [ -n "$reuse_win" ]; then
      win="$reuse_win"
      reuse_win=""
    else
      win="$(tmux new-window -d -P -F '#{window_id}' -t "$target:" -c "$cwd" -n "$name")"
    fi
    tmux send-keys -t "$win" "$cmd" C-m
  fi

  printf '  %s[%d] %-46s %s\n' "$mark" "$planned" "$cwd" "$cmd"
done < "$SNAP"

echo
if [ "$DRY" -eq 1 ]; then
  echo "미리보기: ${planned}개 복원 예정, ${skipped}개 건너뜀"
  echo "실제로 하려면 --dry-run 빼고 다시 실행."
elif [ "$planned" -eq 0 ]; then
  echo "복원할 게 없어 (${skipped}개 건너뜀)"
else
  echo "${planned}개 복원, ${skipped}개 건너뜀  (세션: $target)"
  [ -z "${TMUX:-}" ] && echo "붙으려면:  agents"
fi
[ "$planned" -gt 0 ] && grep -q 'guess$' "$SNAP" 2>/dev/null && \
  echo "* 표시는 세션 ID를 추정한 항목 — 엉뚱한 대화가 열리면 그 창에서 /resume 으로 골라."
exit 0
