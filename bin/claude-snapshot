#!/usr/bin/env bash
# 지금 돌아가고 있는 Claude Code 세션의 (작업 디렉터리, 세션 ID)를 기록한다.
# 재부팅으로 터미널이 통째로 날아가도 claude-restore 가 이 파일로 되살린다.
#
#   claude-snapshot           스냅샷 파일 갱신
#   claude-snapshot --print   파일은 건드리지 않고 결과만 stdout 으로
#
# 출력 형식: <작업디렉터리>\t<세션ID>\t<출처>
#   출처 cmd   = 프로세스 커맨드라인의 --resume 에서 확실하게 얻음
#   출처 guess = 커맨드라인에 없어서, 그 디렉터리에서 가장 최근에 갱신된
#                대화 파일로 추정 (같은 디렉터리에 여러 세션이 있으면 어긋날 수 있음)
set -euo pipefail

SNAP_DIR="$HOME/.claude"
SNAP="$SNAP_DIR/session-snapshot.tsv"
PREV="$SNAP_DIR/session-snapshot.tsv.prev"
PROJECTS="$SNAP_DIR/projects"
PRINT_ONLY=0

case "${1:-}" in
  --print|-p) PRINT_ONLY=1 ;;
  -h|--help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  "") ;;
  *) echo "알 수 없는 옵션: $1" >&2; exit 1 ;;
esac

# ── 1차 수집: 실행 중인 claude 프로세스의 cwd 와 (있으면) 세션 ID ──────
# 커맨드 첫 토큰의 basename 이 정확히 "claude" 인 것만 잡는다 —
# 내부 헬퍼(.../versions/<버전> --chr ...)는 basename 이 달라 자동으로 걸러진다.
raw=""
while read -r pid cmd; do
  first="${cmd%% *}"
  [ "${first##*/}" = "claude" ] || continue
  case " $cmd " in *" --chr"*) continue ;; esac

  cwd="$(lsof -w -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
  [ -n "$cwd" ] && [ -d "$cwd" ] || continue

  sid="$(printf '%s' "$cmd" \
    | grep -oE -- '(--resume|-r)[[:space:]=]+[0-9a-fA-F-]{36}' \
    | grep -oE '[0-9a-fA-F-]{36}' | head -1 || true)"

  raw="${raw}${cwd}	${sid}
"
done < <(ps -eo pid=,command=)

if [ -z "$raw" ]; then
  if [ "$PRINT_ONLY" -eq 1 ]; then exit 0; fi
  # 하나도 못 찾았으면 기존 스냅샷을 절대 덮어쓰지 않는다.
  # (재부팅 직후처럼 claude 가 아직 안 뜬 시점에 스냅샷이 돌면
  #  복구할 목록이 통째로 지워지는 게 가장 큰 사고다.)
  echo "실행 중인 claude 세션 없음 — 기존 스냅샷 유지" >&2
  exit 0
fi

# ── 2차 보정: --resume 없이 뜬 프로세스의 세션 ID 추정 ─────────────────
# Claude Code 는 대화를 ~/.claude/projects/<cwd의 특수문자를 -로 치환>/<세션ID>.jsonl
# 에 계속 append 하므로, mtime 이 가장 최신인 파일이 살아있는 세션일 확률이 높다.
# 이미 --resume 으로 확정된 ID 는 후보에서 제외해 중복 배정을 막는다.
used="$(mktemp "${TMPDIR:-/tmp}/claude-snap-used.XXXXXX")"
out="$(mktemp "${TMPDIR:-/tmp}/claude-snap-out.XXXXXX")"
trap 'rm -f "$used" "$out"' EXIT

printf '%s' "$raw" | cut -f2 | grep -v '^$' > "$used" || true

while IFS=$'\t' read -r cwd sid; do
  [ -n "${cwd:-}" ] || continue
  origin="cmd"

  if [ -z "$sid" ]; then
    origin="guess"
    slug="$(printf '%s' "$cwd" | sed 's/[^a-zA-Z0-9]/-/g')"
    projdir="$PROJECTS/$slug"
    if [ -d "$projdir" ]; then
      candidates="$(ls -t "$projdir"/*.jsonl 2>/dev/null || true)"
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        base="${f##*/}"
        cand="${base%.jsonl}"
        if ! grep -qxF "$cand" "$used"; then
          sid="$cand"
          printf '%s\n' "$cand" >> "$used"
          break
        fi
      done <<EOF
$candidates
EOF
    fi
  fi

  # 세션 ID를 못 구했으면 빈 칸 대신 "-" 를 쓴다.
  # 탭은 IFS 공백류라서 빈 필드를 그대로 두면 읽는 쪽에서 칼럼이 밀린다.
  printf '%s\t%s\t%s\n' "$cwd" "${sid:--}" "$origin" >> "$out"
done <<EOF
$raw
EOF

result="$(sort -u "$out")"

if [ "$PRINT_ONLY" -eq 1 ]; then
  printf '%s\n' "$result"
  exit 0
fi

mkdir -p "$SNAP_DIR"
[ -f "$SNAP" ] && cp "$SNAP" "$PREV"

tmp="$(mktemp "${TMPDIR:-/tmp}/claude-snapshot.XXXXXX")"
printf '%s\n' "$result" > "$tmp"
mv "$tmp" "$SNAP"

count="$(printf '%s\n' "$result" | wc -l | tr -d ' ')"
guessed="$(printf '%s\n' "$result" | grep -c 'guess$' || true)"
echo "claude 세션 ${count}개 기록 → $SNAP${guessed:+  (그중 ${guessed}개는 추정)}"
